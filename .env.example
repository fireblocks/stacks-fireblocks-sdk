# Fireblocks API credentials — get these from your Fireblocks workspace.
# Never commit real values; this file only holds placeholders.
FIREBLOCKS_API_KEY=00000000-0000-0000-0000-000000000000
FIREBLOCKS_SECRET_KEY_PATH=./secrets/fireblocks_secret.key
FIREBLOCKS_BASE_PATH=https://api.fireblocks.io/v1

# Stacks network: set to TESTNET for testnet, anything else = mainnet
NETWORK=TESTNET

# REST API server port
PORT=3000

# Early-exit KMS cosigner service base URL.
# Optional — defaults to the built-in testnet URL when NETWORK=testnet.
# No value is provisioned for mainnet yet.
EARLY_EXIT_SIGNER_URL=
