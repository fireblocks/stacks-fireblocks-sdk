# Fireblocks API credentials — get these from your Fireblocks workspace.
# Never commit real values; this file only holds placeholders.
FIREBLOCKS_API_KEY=00000000-0000-0000-0000-000000000000
FIREBLOCKS_SECRET_KEY_PATH=./secrets/fireblocks_secret.key
FIREBLOCKS_BASE_PATH=https://api.fireblocks.io/v1

# Stacks network: set to TESTNET for testnet, anything else = mainnet
NETWORK=TESTNET

# REST API server port
PORT=3000

# Early-exit KMS cosigner service base URL.
# Optional — defaults to the built-in testnet URL when NETWORK=testnet.
# No value is provisioned for mainnet yet.
EARLY_EXIT_SIGNER_URL=

# Signer-manager ALLOWLIST for PoX-5 bonds and reward claims.
#
# Optional. Leave EMPTY (as below) to allow any signer manager — this is the default, and
# is what lets a staker enrol with a manager they enter themselves.
#
# When set, it is an exact-match allowlist: a manager not listed here is refused before
# anything is signed. Format is a comma-separated list of Stacks contract principals,
# each `<address>.<contract-name>`. Whitespace around entries is ignored.
#
# A malformed entry makes the server REFUSE TO START rather than boot with the allowlist
# silently off — an empty allowlist means "allow everything", so a typo would disable the
# control you just switched on.
#
# Example (mock values — replace with the managers you actually support):
#   SIGNER_MANAGER_ALLOWLIST=SP1234567890ABCDEFGHJKMNPQRSTVWXYZ12345.pool-alpha,ST1234567890ABCDEFGHJKMNPQRSTVWXYZ12345.pool-beta
#
# Single entry:
#   SIGNER_MANAGER_ALLOWLIST=SP1234567890ABCDEFGHJKMNPQRSTVWXYZ12345.pool-alpha
#
# Reward payout amounts are NOT configured here: pox-5 computes the staker's entitlement
# and the claim is bounded by that value read from chain, for every manager.
SIGNER_MANAGER_ALLOWLIST=

# How long the server waits on a Fireblocks request before returning it as pending.
# Optional, positive integer milliseconds; an invalid value makes the server refuse to start.
#   FIREBLOCKS_POLL_TIMEOUT_MS      machine-paced states (default 1800000, 30 minutes)
#   FIREBLOCKS_APPROVAL_TIMEOUT_MS  states waiting on a person (defaults to FIREBLOCKS_POLL_TIMEOUT_MS)
# A request still waiting when the budget runs out is reported as pending, not failed;
# retrying resumes the same request.
FIREBLOCKS_POLL_TIMEOUT_MS=
FIREBLOCKS_APPROVAL_TIMEOUT_MS=
