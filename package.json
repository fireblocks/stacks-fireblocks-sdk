{
  "name": "stacks-fireblocks-sdk",
  "version": "1.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "jest --testPathIgnorePatterns=e2e",
    "test:coverage": "jest --coverage --testPathIgnorePatterns=e2e",
    "test:e2e": "jest --testPathPatterns=e2e --runInBand --testTimeout=300000",
    "typecheck": "tsc --noEmit",
    "patch": "patch-package",
    "prebuild": "npm run patch",
    "build": "rimraf dist && tsc -p tsconfig.build.json && node esbuild.config.mjs",
    "lint": "eslint src/"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/dotenv": "^6.1.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.12",
    "esbuild": "^0.28.1",
    "eslint": "^9.30.0",
    "jest": "^30.2.0",
    "patch-package": "^8.0.1",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "@fireblocks/ts-sdk": "^10.1.1",
